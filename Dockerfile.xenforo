FROM php:8.3-fpm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libfreetype6-dev \
        libjpeg62-turbo-dev \
        libpng-dev \
        libmagickwand-dev \
        libgmp-dev \
        libicu-dev \
        libzip-dev \
        unzip \
        pkg-config \
        git \
        autoconf \
        build-essential \
        inotify-tools \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        mysqli \
        pdo_mysql \
        gd \
        exif \
        gmp \
        intl \
        zip \
    && pecl install imagick \
    && docker-php-ext-enable imagick \
    && git clone --depth 1 https://github.com/jvoisin/snuffleupagus.git /tmp/snuffleupagus \
    && cd /tmp/snuffleupagus/src \
    && phpize \
    && ./configure \
    && make -j"$(nproc)" \
    && make install \
    && docker-php-ext-enable snuffleupagus \
    && rm -rf /tmp/snuffleupagus \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

COPY config/watch-php.sh /usr/local/bin/watch-php.sh
COPY config/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/watch-php.sh \
    && chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

CMD ["php-fpm", "-F"]